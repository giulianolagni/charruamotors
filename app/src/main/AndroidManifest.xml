<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth Clássico (SPP) para o scanner OBD2 ELM327.
         Android 11 e anterior: permissões legadas. Android 12+: permissões em tempo de execução. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Modo HUD: janela flutuante sobre o Waze, em serviço de primeiro plano ligado ao scanner
         Bluetooth (tipo connectedDevice, exigido a partir do Android 14). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bluetooth opcional: o app também roda no emulador usando o scanner simulado. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Visibilidade de pacotes (Android 11+): abrir o player de música ativo e o Waze pelo ícone
         do app, e saber se o Waze está instalado (senão, Play Store). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="waze" />
        </intent>
        <package android:name="com.waze" />
    </queries>

    <application
        android:name=".CharruaMotorsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CharruaMotors">

        <!-- Activity 1: Login (tela inicial) -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity 2: Dashboard / Home -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />

        <!-- Activity 3: Formulário de Veículos (CRUD) -->
        <activity
            android:name=".ui.veiculo.VeiculoFormActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activity 4: Diagnóstico OBD2, Manutenções e Abastecimentos (abas) -->
        <activity
            android:name=".ui.diagnostico.DiagnosticoActivity"
            android:exported="false"
            android:parentActivityName=".ui.dashboard.DashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ferramentas de Oficina (abertas pelo hub da aba OBD2) -->
        <activity
            android:name=".ui.oficina.bateria.TesteBateriaActivity"
            android:exported="false"
            android:parentActivityName=".ui.diagnostico.DiagnosticoActivity" />
        <activity
            android:name=".ui.oficina.replay.ReplayLogActivity"
            android:exported="false"
            android:parentActivityName=".ui.diagnostico.DiagnosticoActivity" />
        <activity
            android:name=".ui.oficina.terminal.TerminalObdActivity"
            android:exported="false"
            android:parentActivityName=".ui.diagnostico.DiagnosticoActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Mini-player: o Acesso a Notificações libera a leitura das sessões de mídia
             (Spotify, YouTube Music...). Nenhuma notificação é lida. -->
        <service
            android:name=".direcao.midia.MidiaNotificacaoService"
            android:exported="true"
            android:label="@string/midia_servico_nome"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- HUD flutuante sobre o Waze: mantém a conexão OBD2 e o polling com o app minimizado. -->
        <service
            android:name=".direcao.hud.HudFlutuanteService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Compartilhamento dos logs CSV salvos na pasta do app (Android 8/9). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.arquivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/caminhos_arquivos" />
        </provider>
    </application>

</manifest>
