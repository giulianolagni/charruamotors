<?xml version="1.0" encoding="utf-8"?>
<!-- Assistente de Primeira Abertura: 4 etapas (uma visível por vez) com "Pular" em todas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.assistente.AssistenteActivity">

    <!-- Topo: passo atual e progresso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="@dimen/espaco_medio"
        android:paddingEnd="@dimen/margem_tela">

        <TextView
            android:id="@+id/texto_passo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            tools:text="Passo 1 de 4" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progresso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:max="4"
            app:trackCornerRadius="4dp"
            tools:progress="1" />

        <TextView
            android:id="@+id/texto_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:text="Permissões essenciais" />

        <TextView
            android:id="@+id/texto_descricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_minimo"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/texto_secundario"
            tools:text="@string/assistente_1_descricao" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/rolagem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margem_tela">

            <!-- Passo 1: permissões essenciais -->
            <LinearLayout
                android:id="@+id/passo_permissoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Passo 2: scanner OBD2 e Bluetooth gatilho do carro -->
            <LinearLayout
                android:id="@+id/passo_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/grupo_sem_permissao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/assistente_2_sem_permissao"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_permitir_bluetooth"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assistente_2_permitir" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/assistente_2_scanner"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/texto_sem_pareados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_minimo"
                    android:text="@string/assistente_2_sem_pareados"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/grupo_scanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_atualizar_pareados"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assistente_2_atualizar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_abrir_bluetooth"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assistente_2_abrir_bluetooth" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:text="@string/assistente_2_gatilho"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <RadioGroup
                    android:id="@+id/grupo_gatilho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_nome_gatilho"
                    style="@style/Widget.CharruaMotors.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/assistente_2_nome_gatilho">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_nome_gatilho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Passo 3: veículo padrão e caixa-preta -->
            <LinearLayout
                android:id="@+id/passo_veiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_veiculo"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/texto_sem_veiculos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_minimo"
                    android:text="@string/assistente_3_sem_veiculos"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/grupo_veiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:text="@string/config_secao_caixa"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_conexao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/config_auto_conexao" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_logs_automaticos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/config_logs" />
            </LinearLayout>

            <!-- Passo 4: recursos de direção (opcional) -->
            <LinearLayout
                android:id="@+id/passo_direcao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </FrameLayout>
    </ScrollView>

    <!-- Rodapé: Pular · Voltar · Próximo/Concluir -->
    <LinearLayout
        android:id="@+id/rodape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espaco_pequeno">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_pular"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistente_pular" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_voltar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:text="@string/assistente_voltar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_proximo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assistente_proximo" />
    </LinearLayout>
</LinearLayout>
