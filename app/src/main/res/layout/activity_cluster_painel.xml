<?xml version="1.0" encoding="utf-8"?>
<!-- Modo Painel Automotivo (celular na horizontal): fundo escuro, alto contraste, tela cheia. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cluster_fundo"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp"
    tools:ignore="HardcodedText">

    <!-- Esquerda: Temp. Água e Temp. Óleo / ATF -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical">

        <com.charruamotors.ui.componentes.GaugeView
            android:id="@+id/bolinha0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1" />

        <com.charruamotors.ui.componentes.GaugeView
            android:id="@+id/bolinha1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- RPM -->
    <com.charruamotors.ui.componentes.GaugeView
        android:id="@+id/gaugeRpm"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="2.4" />

    <!-- Centro: marcha/alavanca, velocidade digital e avisos -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.9"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textoAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:minHeight="36dp"
            android:textColor="@color/cluster_alerta"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoLegendaMarcha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cluster_rotulo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoMarcha"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="120sp"
            android:autoSizeMinTextSize="40sp"
            android:autoSizeTextType="uniform"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/cluster_destaque"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoVelocidade"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeMinTextSize="32sp"
            android:autoSizeTextType="uniform"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/cluster_valor"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoUnidadeVelocidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="km/h"
            android:textColor="@color/cluster_rotulo"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Velocidade -->
    <com.charruamotors.ui.componentes.GaugeView
        android:id="@+id/gaugeVelocidade"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="2.4" />

    <!-- Direita: Turbo/MAP e Bateria -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical">

        <com.charruamotors.ui.componentes.GaugeView
            android:id="@+id/bolinha2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1" />

        <com.charruamotors.ui.componentes.GaugeView
            android:id="@+id/bolinha3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
