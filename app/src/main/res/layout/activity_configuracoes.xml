<?xml version="1.0" encoding="utf-8"?>
<!-- Configurações (menu lateral e faixa da caixa-preta na aba OBD2): caixa-preta, aparência e assistente. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.configuracoes.ConfiguracoesActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.CharruaMotors.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:navigationContentDescription="@string/voltar"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/config_titulo" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <!-- Caixa-preta automática -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/espaco_pequeno"
                        android:gravity="center_vertical"
                        android:text="@string/config_secao_caixa"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        app:drawableStartCompat="@drawable/ic_caixa_preta"
                        app:drawableTint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_minimo"
                        android:text="@string/config_secao_caixa_descricao"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/texto_status_sessao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary"
                        tools:text="Caixa-preta ativa · Gatilho: Toyota SW4" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_auto_conexao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/config_auto_conexao" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_logs_automaticos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/config_logs" />

                    <include
                        android:id="@+id/linha_gatilho"
                        layout="@layout/item_config_valor" />

                    <include
                        android:id="@+id/linha_scanner"
                        layout="@layout/item_config_valor" />

                    <include
                        android:id="@+id/linha_veiculo"
                        layout="@layout/item_config_valor" />

                    <!-- Bateria "Sem restrições" (One UI / Android 14+ pode barrar o serviço vindo do segundo plano) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/ponto_bateria"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/ponto_status"
                            android:backgroundTint="@color/status_pendente" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espaco_medio"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/config_bateria"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/texto_bateria"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/texto_secundario"
                                tools:text="@string/config_bateria_pendente" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_bateria"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/config_bateria_liberar"
                            app:icon="@drawable/ic_bateria" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Aparência e Painel -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_secao_aparencia"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_medio"
                        android:text="@string/config_tema"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/grupo_tema"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_tema_sistema"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/config_tema_sistema" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_tema_claro"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/config_tema_claro" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_tema_escuro"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/config_tema_escuro" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_grande"
                        android:text="@string/config_unidade"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/config_unidade_descricao"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/texto_secundario" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/grupo_unidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_unidade_kpa"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/config_unidade_kpa" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_unidade_bar"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/config_unidade_bar" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_unidade_psi"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/config_unidade_psi" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Assistente -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_secao_assistente"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_refazer_assistente"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/config_refazer_assistente" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_checklist"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/config_abrir_checklist"
                        app:icon="@drawable/ic_checklist" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
