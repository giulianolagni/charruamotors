<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.dashboard.DashboardActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.CharruaMotors.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:title="@string/dashboard_titulo" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <!-- Resumo geral -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_resumo"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:id="@+id/texto_boas_vindas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="Olá, Administrador" />

                    <TextView
                        android:id="@+id/texto_total_veiculos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/texto_secundario"
                        tools:text="2 veículos cadastrados" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Atalho para o diagnóstico OBD2 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_scanner"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_medio"
                android:text="@string/botao_conectar_scanner" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/dashboard_meus_veiculos"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_veiculos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="88dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@android:layout/simple_list_item_2" />

                <TextView
                    android:id="@+id/texto_lista_vazia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/espaco_grande"
                    android:text="@string/dashboard_lista_vazia"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/texto_secundario" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/botao_novo_veiculo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/margem_tela"
            android:text="@string/botao_novo_veiculo"
            app:icon="@android:drawable/ic_input_add" />
    </FrameLayout>
</LinearLayout>
