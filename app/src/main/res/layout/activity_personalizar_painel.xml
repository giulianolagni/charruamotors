<?xml version="1.0" encoding="utf-8"?>
<!-- Personalizar Painel: ordem dos blocos (arrastar e soltar), estilo dos mostradores, os 4 relógios,
     a lista rápida de sensores e o HUD flutuante. Tudo é salvo na hora. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.painel.PersonalizarPainelActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.CharruaMotors.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:navigationContentDescription="@string/voltar"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/personalizar_titulo" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <!-- 1. Ordem do topo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personalizar_ordem"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaco_pequeno"
                android:text="@string/personalizar_ordem_dica"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_secoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_secao_painel" />

            <!-- 2. Estilo dos mostradores, com prévia ao vivo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_estilo"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupo_estilo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_estilo_esportivo"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/personalizar_estilo_esportivo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_estilo_digital"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/personalizar_estilo_digital" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_estilo_fita"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/personalizar_estilo_fita" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/texto_estilo_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_minimo"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario"
                tools:text="Ponteiro em arco com escala e zona vermelha" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="@dimen/espaco_pequeno">

                    <com.charruamotors.ui.componentes.GaugeView
                        android:id="@+id/previa_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="@dimen/espaco_minimo" />

                    <com.charruamotors.ui.componentes.GaugeView
                        android:id="@+id/previa_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="@dimen/espaco_minimo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Os 4 relógios -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_mostradores"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/personalizar_mostradores_dica"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario" />

            <LinearLayout
                android:id="@+id/grupo_mostradores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 4. Lista rápida -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_lista_rapida"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/texto_lista_rapida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario"
                tools:text="Nenhum marcado: a lista mostra todos os sensores suportados." />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_lista_rapida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_limpar_lista_rapida"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personalizar_lista_limpar" />

            <!-- 5. HUD flutuante -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_hud"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <include
                android:id="@+id/config_hud"
                layout="@layout/conteudo_config_hud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_restaurar_padrao"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_restaurar" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
