<?xml version="1.0" encoding="utf-8"?>
<!-- Personalizar Painel 2.0: todos os blocos (arrastar, remover e adicionar de volta), botões da
     Navegação, lista dinâmica de mostradores com estilo individual, lista rápida ordenável e o HUD.
     Tudo é salvo na hora. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.painel.PersonalizarPainelActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.CharruaMotors.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:navigationContentDescription="@string/voltar"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/personalizar_titulo" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <!-- 1. Blocos do Painel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personalizar_ordem"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaco_pequeno"
                android:text="@string/personalizar_ordem_dica"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_secoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_secao_painel" />

            <TextView
                android:id="@+id/texto_todos_removidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/espaco_pequeno"
                android:text="@string/personalizar_todos_removidos"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario"
                android:visibility="gone" />

            <!-- Blocos removidos: 1 toque para trazer de volta -->
            <LinearLayout
                android:id="@+id/grupo_removidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/personalizar_removidos"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/texto_secundario" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_removidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Botões do bloco Navegação, um a um -->
            <LinearLayout
                android:id="@+id/grupo_botoes_navegacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:text="@string/personalizar_botoes_navegacao"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_botoes_navegacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/personalizar_atalhos_ordem"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_ordem_atalhos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- 2. Mostradores: lista dinâmica com estilo individual -->
            <TextView
                android:id="@+id/titulo_mostradores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_mostradores"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaco_pequeno"
                android:text="@string/personalizar_mostradores_dica"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario" />

            <!-- Layouts rápidos: troca todos os relógios de uma vez -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personalizar_layouts_rapidos"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaco_pequeno"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_layout_padrao"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espaco_pequeno"
                    android:layout_weight="1"
                    android:text="@string/personalizar_layout_padrao" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_layout_turbo_flex"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/personalizar_layout_turbo_flex" />
            </LinearLayout>

            <!-- Prévia com os dois primeiros relógios, cada um no seu estilo -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:id="@+id/grupo_previa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_pequeno" />
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_mostradores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_mostrador_editor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_adicionar_mostrador"
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espaco_pequeno"
                    android:layout_weight="1"
                    android:text="@string/personalizar_adicionar_mostrador"
                    app:icon="@drawable/ic_adicionar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_estilo_todos"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/personalizar_estilo_todos" />
            </LinearLayout>

            <!-- 3. Lista rápida: escolha e ordem -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_lista_rapida"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/texto_lista_rapida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario"
                tools:text="Nenhum marcado: a lista mostra todos os sensores suportados." />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_lista_rapida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_ordem_rapida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_limpar_lista_rapida"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personalizar_lista_limpar" />

            <!-- 4. HUD flutuante -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_hud"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <include
                android:id="@+id/config_hud"
                layout="@layout/conteudo_config_hud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_restaurar_padrao"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_grande"
                android:text="@string/personalizar_restaurar" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
