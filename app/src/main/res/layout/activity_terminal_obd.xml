<?xml version="1.0" encoding="utf-8"?>
<!-- Oficina: Terminal ELM327 didático (ajuda, atalhos com um toque e respostas traduzidas) e Varredura
     amigável de PIDs (cruza as respostas com o catálogo), em duas abas internas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    tools:context=".ui.oficina.terminal.TerminalObdActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.CharruaMotors.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:navigationContentDescription="@string/voltar"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:subtitleTextColor="@color/branco"
            app:title="@string/terminal_titulo" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/abas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azul_primario"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/laranja_destaque"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/branco"
            app:tabTextColor="@color/branco">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terminal_aba_terminal" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terminal_aba_varredura" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Aba Terminal -->
        <LinearLayout
            android:id="@+id/painel_terminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/espaco_pequeno">

            <!-- Ajuda: o que dá para fazer no terminal -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ajuda_terminal"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/espaco_medio"
                    android:paddingTop="@dimen/espaco_pequeno"
                    android:paddingEnd="@dimen/espaco_minimo"
                    android:paddingBottom="@dimen/espaco_pequeno">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="@dimen/espaco_pequeno"
                            android:gravity="center_vertical"
                            android:text="@string/terminal_ajuda_titulo"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            app:drawableStartCompat="@drawable/ic_info"
                            app:drawableTint="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_ocultar_ajuda"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:text="@string/terminal_ajuda_ocultar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/texto_dicas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espaco_pequeno"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        tools:text="• Consulte a bateria com ATRV\n• Altere o foco com ATSH 7E0\n• Leia o RPM com 210C" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ScrollView
                android:id="@+id/rolagem_log"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/fundo_terminal"
                android:padding="@dimen/espaco_pequeno">

                <TextView
                    android:id="@+id/texto_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/terminal_log_vazio"
                    android:textColor="@color/terminal_texto"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupo_atalhos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <!-- O que o comando digitado (ou o último atalho) faz -->
            <TextView
                android:id="@+id/texto_descricao_comando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/espaco_minimo"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="ATRV: lê a tensão da bateria"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_comando"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/terminal_comando_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_comando"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:imeOptions="actionSend"
                        android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                        android:maxLength="48"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_enviar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_pequeno"
                    android:text="@string/terminal_enviar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_limpar_log"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terminal_limpar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_copiar_log"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terminal_copiar_log" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_laudo_terminal"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terminal_laudo" />
            </LinearLayout>
        </LinearLayout>

        <!-- Aba Varredura de PIDs (engenharia reversa) -->
        <LinearLayout
            android:id="@+id/painel_varredura"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margem_tela"
            android:paddingTop="@dimen/espaco_pequeno"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_preset"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/varredura_preset">

                <AutoCompleteTextView
                    android:id="@+id/campo_preset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_cabecalho"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espaco_pequeno"
                    android:layout_weight="1"
                    android:hint="@string/varredura_cabecalho">

                    <AutoCompleteTextView
                        android:id="@+id/campo_cabecalho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_servico"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/varredura_servico">

                    <AutoCompleteTextView
                        android:id="@+id/campo_servico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espaco_pequeno"
                    android:layout_weight="1"
                    android:hint="@string/varredura_inicio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_inicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                        android:maxLength="4"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/varredura_fim">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_fim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                        android:maxLength="4"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_minimo"
                android:text="@string/varredura_aviso"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_varredura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/varredura_iniciar" />

                <!-- Filtro rápido: só o que o carro respondeu (identificados + desconhecidos) -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_so_respondeu"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_pequeno"
                    android:layout_weight="1"
                    android:checked="true"
                    android:ellipsize="end"
                    tools:text="Ver apenas o que a SW4 respondeu" />
            </LinearLayout>

            <!-- Barra colorida: identificados, desconhecidos, ignorados e o que falta -->
            <com.charruamotors.ui.componentes.BarraVarreduraView
                android:id="@+id/barra_varredura"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_barra_varredura"
                android:layout_marginTop="@dimen/espaco_pequeno" />

            <TextView
                android:id="@+id/texto_metricas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_minimo"
                android:fontFeatureSettings="tnum"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="12 sensores encontrados · 9 identificados · 244 ignorados" />

            <TextView
                android:id="@+id/texto_progresso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="128/256 · 19 responderam · 2180" />

            <TextView
                android:id="@+id/texto_varredura_vazia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/espaco_pequeno"
                android:text="@string/varredura_vazia"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/texto_secundario" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_resultados"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_resultado_pid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_relatorio"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaco_pequeno"
                android:text="@string/varredura_relatorio" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
