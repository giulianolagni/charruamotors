<?xml version="1.0" encoding="utf-8"?>
<!-- Escolhas do HUD flutuante: visual (v2.2.7), tamanho, sensores fixados e estilo. Usado no diálogo de ativação do
     HUD (aba Painel) e na tela Personalizar Painel (EditorConfigHud). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hud_config_visual"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupo_preset_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_minimo"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_hud_preset_padrao"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/hud_config_preset_padrao" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_hud_preset_esportivo"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/hud_config_preset_esportivo" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/texto_preset_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_minimo"
        android:text="@string/hud_config_esportivo_dica"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/texto_secundario" />

    <!-- Tamanho, sensores e estilo: só no visual Padrão. -->
    <LinearLayout
        android:id="@+id/opcoes_padrao_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hud_config_tamanho"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupo_tamanho_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_minimo"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_hud_minimizado"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hud_config_minimizado" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_hud_expandido"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hud_config_expandido" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/texto_tamanho_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_minimo"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/texto_secundario" />

    <TextView
        android:id="@+id/titulo_sensores_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:text="@string/hud_config_sensores"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <LinearLayout
        android:id="@+id/chips_sensores_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_minimo"
        android:orientation="vertical" />

    <!-- Ordem das células do HUD: arraste pela alça -->
    <TextView
        android:id="@+id/titulo_ordem_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_pequeno"
        android:text="@string/hud_config_ordem"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/texto_secundario" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista_ordem_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:text="@string/hud_config_estilo"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupo_estilo_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_minimo"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_hud_numeros"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/hud_config_numeros" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_hud_grandes"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/hud_config_grandes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_hud_barras"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/hud_config_barras" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</LinearLayout>
