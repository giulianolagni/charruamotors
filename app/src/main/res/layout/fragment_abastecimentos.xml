<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista_abastecimentos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/margem_tela"
        android:paddingBottom="88dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_abastecimento" />

    <TextView
        android:id="@+id/texto_lista_vazia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/espaco_grande"
        android:text="@string/abastecimentos_lista_vazia"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/texto_secundario" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/botao_novo_abastecimento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/margem_tela"
        android:text="@string/abastecimento_novo"
        android:textColor="@color/branco"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/branco" />
</FrameLayout>
