<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Histórico: abastecimentos, logs CSV/TXT salvos e diário de viagens, num seletor no topo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupo_historico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margem_tela"
        android:layout_marginTop="@dimen/espaco_pequeno"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_historico_abastecimentos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/historico_abastecimentos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_historico_logs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/historico_logs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_historico_viagens"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/historico_viagens" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Abastecimentos: o Fragment existente, como filho -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container_abastecimentos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Logs CSV / TXT salvos (Data Logger e caixa-preta) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/painel_logs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/titulo_logs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/historico_logs_titulo"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_abrir_visualizador"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/historico_abrir_visualizador"
                        app:icon="@drawable/ic_grafico" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_logs_dica"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario" />

                <TextView
                    android:id="@+id/texto_logs_vazio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/espaco_medio"
                    android:text="@string/historico_logs_vazio"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/texto_secundario"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_arquivo_log" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Diário de viagens: relatórios .txt das sessões da caixa-preta e as leituras salvas -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/painel_viagens"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <TextView
                    android:id="@+id/titulo_viagens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_viagens_titulo"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_viagens_dica"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario" />

                <TextView
                    android:id="@+id/texto_viagens_vazio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/espaco_medio"
                    android:text="@string/historico_viagens_vazio"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/texto_secundario"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_viagens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_arquivo_log" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_grande"
                    android:text="@string/obd_historico_titulo"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/texto_leituras_vazio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/espaco_pequeno"
                    android:text="@string/obd_historico_vazio"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/texto_secundario" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_leituras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_leitura_historico" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
