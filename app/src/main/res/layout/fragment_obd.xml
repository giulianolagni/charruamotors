<?xml version="1.0" encoding="utf-8"?>
<!-- Aba Painel (v1.5): card de conexão inteligente no topo (início rápido Bluetooth/Simulado quando
     desconectado; barra compacta de status quando conectado) e os blocos configurados em
     "Personalizar Painel" (todos reordenáveis e removíveis). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margem_tela"
        android:paddingTop="@dimen/espaco_pequeno"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="@dimen/margem_tela">

        <!-- Conexão: início rápido (desconectado) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_inicio_rapido"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/raio_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_medio">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/conexao_titulo"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/texto_estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario"
                    tools:text="Desconectado" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Carro real: o adaptador salvo (ex.: OBDII) e o atalho para trocar o pareado -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espaco_pequeno"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_conectar_carro"
                            style="@style/Widget.Material3.Button.Icon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/conexao_carro"
                            app:icon="@drawable/ic_bluetooth" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/texto_adaptador"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:paddingStart="@dimen/espaco_minimo"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="@color/texto_secundario"
                                tools:text="Adaptador: OBDII" />

                            <ImageButton
                                android:id="@+id/botao_trocar_adaptador"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/conexao_trocar_adaptador"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_trocar"
                                app:tint="@color/texto_secundario" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Simulado: testar sem carro com 1 toque -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_conectar_simulado"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/conexao_simulado"
                            app:icon="@drawable/ic_simulado" />

                        <!-- Demonstra o estado de Erro ao vivo no modo simulado -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_simular_falha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:paddingStart="@dimen/espaco_minimo"
                            android:text="@string/conexao_simular_falha"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/texto_secundario" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Conectando: cancelar; e o log bruto do ELM327 (o que se precisa quando a conexão falha) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_registro_comunicacao"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obd_registro_botao" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_cancelar_conexao"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_pequeno"
                        android:text="@string/obd_cancelar_conexao"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Conexão: barra compacta (conectado), libera a tela para os mostradores -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/barra_conectado"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espaco_medio"
                android:paddingEnd="@dimen/espaco_minimo">

                <View
                    android:id="@+id/ponto_conectado"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/ponto_status"
                    android:backgroundTint="@color/status_ok" />

                <TextView
                    android:id="@+id/texto_status_compacto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_pequeno"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    tools:text="Conectado · OBDII · 7E0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_desconectar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obd_desconectar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Perfil escolhido automaticamente (VDS do VIN / sondagem da ECU): aviso discreto, Manter ou Ignorar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_perfil_automatico"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espaco_medio"
                android:paddingEnd="@dimen/espaco_minimo">

                <TextView
                    android:id="@+id/texto_perfil_automatico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/espaco_pequeno"
                    android:paddingBottom="@dimen/espaco_pequeno"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Perfil identificado: Toyota Hilux SW4 (VDS do VIN)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_manter_perfil"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obd_perfil_manter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_ignorar_perfil"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obd_perfil_ignorar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Blocos do Painel: o ObdFragment mostra, esconde e reposiciona os filhos conforme
             "Personalizar Painel" -->
        <!-- Alertas de proteção (água, ATF, alternador): vermelho enquanto algum limite estiver ultrapassado -->
        <TextView
            android:id="@+id/texto_alertas_protecao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:background="@drawable/fundo_alerta_protecao"
            android:gravity="center"
            android:padding="@dimen/espaco_pequeno"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@android:color/white"
            android:visibility="gone"
            tools:text="Atenção: ÁGUA QUENTE"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/container_secoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Músicas: mini-player (Spotify / YouTube Music) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_musica"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/espaco_medio"
                    android:paddingTop="@dimen/espaco_pequeno"
                    android:paddingEnd="@dimen/espaco_pequeno"
                    android:paddingBottom="@dimen/espaco_pequeno">

                <!-- Mini-player: só aparece com um player ativo -->
                <LinearLayout
                    android:id="@+id/grupo_midia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/area_abrir_player"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/midia_capa"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imagem_capa_midia"
                            android:layout_width="@dimen/tamanho_capa_midia"
                            android:layout_height="@dimen/tamanho_capa_midia"
                            android:background="@drawable/fundo_capa_midia"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_musica" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espaco_pequeno"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/texto_titulo_midia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                tools:text="Nome da faixa" />

                            <TextView
                                android:id="@+id/texto_artista_midia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/texto_secundario"
                                tools:text="Artista · Spotify" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/botao_midia_anterior"
                        android:layout_width="@dimen/botao_midia"
                        android:layout_height="@dimen/botao_midia"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/midia_anterior"
                        android:src="@drawable/ic_anterior" />

                    <ImageButton
                        android:id="@+id/botao_midia_tocar"
                        android:layout_width="@dimen/botao_midia"
                        android:layout_height="@dimen/botao_midia"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/midia_tocar"
                        android:src="@drawable/ic_tocar" />

                    <ImageButton
                        android:id="@+id/botao_midia_proxima"
                        android:layout_width="@dimen/botao_midia"
                        android:layout_height="@dimen/botao_midia"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/midia_proxima"
                        android:src="@drawable/ic_proxima" />
                </LinearLayout>

                <!-- Sem player ativo -->
                <TextView
                    android:id="@+id/texto_midia_vazio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/espaco_minimo"
                    android:paddingBottom="@dimen/espaco_minimo"
                    android:text="@string/midia_sem_player"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario"
                    android:visibility="gone" />

                <!-- Sem Acesso a Notificações: atalho discreto (não bloqueia o scanner) -->
                <LinearLayout
                    android:id="@+id/grupo_midia_permissao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_ativar_midia"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/midia_ativar"
                        app:icon="@drawable/ic_musica" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espaco_pequeno"
                        android:text="@string/midia_ativar_dica"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/texto_secundario" />
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navegação: atalhos do Waze e Modo HUD (cada botão pode ser escondido) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_navegacao"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/espaco_medio"
                    android:paddingEnd="@dimen/espaco_medio"
                    android:paddingBottom="@dimen/espaco_pequeno">

                    <!-- Atalhos (v1.7): cada um pode ser escondido e a ordem é a do Personalizar Painel;
                         o fragmento reanexa os botões nesta grade na ordem escolhida. -->
                    <GridLayout
                        android:id="@+id/grupo_atalhos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:columnCount="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_waze_abrir"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="2dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/waze_abrir"
                            app:icon="@drawable/ic_navegacao" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_maps"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="2dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/maps_abrir"
                            app:icon="@drawable/ic_navegacao" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_spotify"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="2dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/spotify_abrir"
                            app:icon="@drawable/ic_musica" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_waze_posto"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="2dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/waze_posto"
                            app:icon="@drawable/ic_posto" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_waze_oficina"
                            style="@style/Widget.Material3.Button.TonalButton.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="2dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/waze_oficina"
                            app:icon="@drawable/ic_oficina" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_hud"
                            style="@style/Widget.Material3.Button.Icon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="2dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/hud_ativar"
                            app:icon="@drawable/ic_hud" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mostradores: lista dinâmica (1 a 12), grade de 2 colunas; Fita em largura total -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_marcadores"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:id="@+id/grupo_mostradores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_pequeno" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Gráfico ao vivo: últimos 60 s de RPM e MAP/turbo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_grafico"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obd_grafico_titulo"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.charruamotors.ui.componentes.TelemetriaChartView
                        android:id="@+id/grafico_telemetria"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/altura_grafico"
                        android:layout_marginTop="@dimen/espaco_pequeno" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Computador de bordo: consumo instantâneo e média da viagem -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_computador"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/obd_bordo_titulo"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/texto_metodo_consumo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/fundo_badge"
                            android:paddingHorizontal="@dimen/espaco_pequeno"
                            android:paddingVertical="2dp"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            app:backgroundTint="?attr/colorSecondaryContainer"
                            tools:text="MAF" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/obd_bordo_instantaneo"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/texto_consumo_km_l"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                tools:text="12,4 km/L" />

                            <TextView
                                android:id="@+id/texto_consumo_l_h"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                tools:text="4,8 L/h" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/obd_bordo_media"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/texto_media_viagem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                tools:text="11,8 km/L" />

                            <TextView
                                android:id="@+id/texto_totais_viagem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                tools:text="3,2 km · 0,27 L" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/texto_parametros_motor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/texto_secundario"
                        tools:text="Motor 1.6 L · flex · E27 (informado pela ECU)" />

                    <Button
                        android:id="@+id/botao_zerar_viagem"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="@string/obd_bordo_zerar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cronômetro automático 0–100 km/h -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cronometro"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obd_cronometro_titulo"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/texto_cronometro_tempo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="?attr/textAppearanceDisplaySmall"
                        tools:text="11,84 s" />

                    <TextView
                        android:id="@+id/texto_cronometro_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/texto_secundario"
                        tools:text="Pronto: a contagem começa quando o carro sair do 0" />

                    <TextView
                        android:id="@+id/texto_cronometro_melhor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:visibility="gone"
                        tools:text="Melhor tempo: 11,84 s"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_armar_cronometro"
                        style="@style/Widget.Material3.Button.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/obd_cronometro_armar"
                        app:icon="@drawable/ic_cronometro" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lista rápida: os sensores escolhidos em "Personalizar Painel" (vazia = todos os suportados),
                 salvar a leitura no histórico e o Data Logger CSV manual -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_lista_sensores"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/titulo_sensores"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/obd_sensores_titulo"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_ver_todos_sensores"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            tools:text="Ver todos (28)"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/texto_sensores_vazio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/espaco_pequeno"
                        android:text="@string/obd_sensores_vazio"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/texto_secundario" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/lista_sensores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="6"
                        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        tools:listitem="@layout/item_sensor"
                        tools:spanCount="2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_salvar_leitura"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/espaco_pequeno"
                            android:layout_weight="1"
                            android:text="@string/obd_salvar_leitura" />

                        <!-- Data Logger: liga/desliga a gravação de todas as leituras em CSV -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botao_gravar_log"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:text="@string/obd_log_gravar" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Informações da ECU -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_info_ecu"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obd_ecu_titulo"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/obd_ecu_vin"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/texto_vin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textIsSelectable="true"
                        tools:text="9BWZZZ377VT004251" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/obd_ecu_pids"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/texto_pids_suportados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="28 de 28 do catálogo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/obd_ecu_perfil"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/texto_perfil_fabricante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="Volkswagen (UDS 22): 3 PIDs ativos" />

                    <TextView
                        android:id="@+id/texto_perfil_observacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/texto_secundario"
                        android:visibility="gone"
                        tools:text="DIDs de referência; confirme com ODIS/VCDS."
                        tools:visibility="visible" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_pequeno"
                        android:text="@string/obd_ecu_protocolo"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/texto_protocolo_ecu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textIsSelectable="true"
                        tools:text="AUTO, ISO 15765-4 (CAN 11/500)\nToyota M-OBD (modo 21, ATSH 7E0)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
