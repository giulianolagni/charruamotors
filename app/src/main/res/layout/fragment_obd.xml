<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <!-- Scanner: modo, dispositivo e conexão -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/raio_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_medio">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obd_scanner"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/grupo_modo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_modo_simulado"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/obd_modo_simulado" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_modo_bluetooth"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/obd_modo_bluetooth" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Só aparece no modo simulado: permite demonstrar o estado de Erro ao vivo -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_simular_falha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:text="@string/obd_simular_falha"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_dispositivo"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:hint="@string/obd_dispositivo">

                    <AutoCompleteTextView
                        android:id="@+id/campo_dispositivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_atualizar_dispositivos"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obd_atualizar_dispositivos" />

                <TextView
                    android:id="@+id/texto_estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Desconectado" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_conectar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espaco_pequeno"
                        android:layout_weight="1"
                        android:text="@string/obd_conectar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botao_desconectar"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/obd_desconectar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dados em tempo real -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/obd_tempo_real"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espaco_pequeno"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obd_rpm"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/valor_rpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:text="2.150 rpm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obd_velocidade"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/valor_velocidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:text="60 km/h" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espaco_pequeno"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obd_temperatura"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/valor_temperatura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:text="90 °C" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="@dimen/raio_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espaco_medio">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/obd_carga"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/valor_carga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:text="35,0 %" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            app:cardCornerRadius="@dimen/raio_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_medio">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obd_bateria"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/texto_secundario" />

                <TextView
                    android:id="@+id/valor_bateria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    tools:text="14,0 V" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_salvar_leitura"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:text="@string/obd_salvar_leitura" />

        <!-- Histórico das leituras salvas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/obd_historico_titulo"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/texto_historico_vazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/espaco_pequeno"
            android:text="@string/obd_historico_vazio"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/texto_secundario" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_historico_leituras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_leitura_historico" />

        <!-- Códigos de falha (DTCs) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:text="@string/obd_codigos_falha"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_ler_codigos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/obd_ler_codigos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_limpar_codigos"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/obd_limpar_codigos" />
        </LinearLayout>

        <TextView
            android:id="@+id/texto_codigos_vazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/espaco_medio"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/texto_secundario"
            tools:text="Nenhum código lido ainda." />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_codigos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"
            tools:listitem="@layout/item_codigo_falha" />
    </LinearLayout>
</ScrollView>
