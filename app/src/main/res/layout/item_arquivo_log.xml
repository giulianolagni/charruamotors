<?xml version="1.0" encoding="utf-8"?>
<!-- Log na lista do Visualizador (CSV de telemetria ou relatório .txt): nome, data e tamanho. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/espaco_pequeno">

    <ImageView
        android:id="@+id/imagem_tipo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_grafico"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_medio"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/texto_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                tools:text="CharruaOBD_20261120_143005_Toyota_SW4.csv" />

            <!-- Só nos logs gravados no Modo Simulado -->
            <TextView
                android:id="@+id/badge_simulado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:background="@drawable/bg_badge_simulado"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="@string/log_badge_simulado"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/laranja_destaque"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/texto_detalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/texto_secundario"
            tools:text="20/11/2026 14:52 · 1,2 MB" />
    </LinearLayout>
</LinearLayout>
