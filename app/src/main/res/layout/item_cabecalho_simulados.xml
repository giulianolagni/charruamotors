<?xml version="1.0" encoding="utf-8"?>
<!-- Pasta retrátil "Simulados (X arquivos)" no topo da lista de logs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/espaco_pequeno">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_simulado"
        app:tint="@color/laranja_destaque" />

    <TextView
        android:id="@+id/texto_titulo_simulados"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_medio"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        tools:text="Simulados (3 arquivos)" />

    <ImageView
        android:id="@+id/imagem_expandir"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_seta_baixo"
        app:tint="?attr/colorControlNormal" />
</LinearLayout>
