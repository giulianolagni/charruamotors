<?xml version="1.0" encoding="utf-8"?>
<!-- PID da varredura amigável: status (identificado / desconhecido / sem resposta), valor
     decodificado, comando com latência e os bytes hexadecimais brutos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/espaco_pequeno">

    <View
        android:id="@+id/marca_status"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/varredura_identificado" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_pequeno"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/texto_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="Identificado: Rotação do motor (PID 210C)" />

            <TextView
                android:id="@+id/texto_valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:fontFeatureSettings="tnum"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary"
                tools:text="850 rpm" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/texto_comando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textStyle="bold"
                tools:text="210C" />

            <TextView
                android:id="@+id/texto_tipo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:gravity="end"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/texto_secundario"
                tools:text="Modo 21 (M-OBD / KWP) · 2 B de dados · 42 ms" />
        </LinearLayout>

        <TextView
            android:id="@+id/texto_bytes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/texto_secundario"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text="61 0C 0D 48" />
    </LinearLayout>
</LinearLayout>
