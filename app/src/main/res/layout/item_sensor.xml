<?xml version="1.0" encoding="utf-8"?>
<!-- Célula da grade de sensores: nome do PID, valor ao vivo e comando OBD2. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espaco_minimo"
    app:cardCornerRadius="@dimen/raio_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/altura_item_sensor"
        android:orientation="vertical"
        android:padding="@dimen/espaco_pequeno">

        <TextView
            android:id="@+id/texto_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="2"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/texto_secundario"
            tools:text="Fluxo de massa de ar (MAF)" />

        <!-- Altura fixa + autoajuste: o valor nunca é cortado (fonte grande do sistema, "−10,00 mm³")
             e trocar o texto a cada ciclo não refaz o layout da aba inteira. -->
        <TextView
            android:id="@+id/texto_valor"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_valor_sensor"
            android:layout_marginTop="@dimen/espaco_minimo"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            tools:text="4,35 g/s" />

        <!-- Mín/Máx da sessão: linha discreta, some quando ainda não há leitura. -->
        <TextView
            android:id="@+id/texto_extremos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/texto_secundario"
            android:visibility="gone"
            tools:text="Mín 59 · Máx 74" />

        <TextView
            android:id="@+id/texto_comando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/texto_secundario"
            tools:text="0110" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
