<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/espaco_pequeno"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/raio_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/espaco_medio">

        <!-- Favorito: o app abre direto neste veículo -->
        <ImageButton
            android:id="@+id/botao_favorito"
            tools:ignore="ContentDescription"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_estrela_borda"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/favorito"
            tools:contentDescription="Marcar como favorito" />

        <TextView
            android:id="@+id/texto_descricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espaco_pequeno"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toStartOf="@id/texto_placa"
            app:layout_constraintStart_toEndOf="@id/botao_favorito"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Chevrolet Onix 2020" />

        <TextView
            android:id="@+id/texto_placa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_placa"
            android:paddingHorizontal="@dimen/espaco_pequeno"
            android:paddingVertical="2dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/texto_primario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="ABC-1234" />

        <TextView
            android:id="@+id/texto_detalhes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/texto_secundario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_descricao"
            tools:text="45000 km • Flex" />

        <!-- v2.3.0: perfil isolado do carro (tag do protocolo/perfil e se é o ativo) -->
        <TextView
            android:id="@+id/texto_perfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_detalhes"
            tools:text="● Ativo · Modo 21" />

        <TextView
            android:id="@+id/texto_consumo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/texto_secundario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_perfil"
            tools:text="Consumo médio: 11,5 km/L" />

        <TextView
            android:id="@+id/texto_proxima_manutencao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/texto_secundario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_consumo"
            tools:text="Próxima manutenção: Troca de óleo — aos 55.000 km (vencida)" />

        <!-- Alerta de DTCs ativos no histórico OBD2 -->
        <TextView
            android:id="@+id/texto_alerta_falhas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:drawablePadding="@dimen/espaco_pequeno"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/erro"
            android:visibility="gone"
            app:drawableStartCompat="@android:drawable/ic_dialog_alert"
            app:drawableTint="@color/erro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_proxima_manutencao"
            tools:text="2 códigos de falha ativos"
            tools:visibility="visible" />

        <!-- v2.3.0: selecionar, editar, perfil técnico, duplicar, sessão de mapeamento -->
        <ImageButton
            android:id="@+id/botao_mais_acoes"
            tools:ignore="ContentDescription"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_mais_opcoes"
            app:layout_constraintBottom_toBottomOf="@id/botao_diagnostico"
            app:layout_constraintEnd_toStartOf="@id/botao_diagnostico"
            app:layout_constraintTop_toTopOf="@id/botao_diagnostico"
            app:tint="?attr/colorControlNormal" />

        <!-- Abre as 4 abas do veículo (Painel ativo) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_diagnostico"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:text="@string/botao_abrir_painel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto_alerta_falhas" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
