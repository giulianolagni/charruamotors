    <!-- Ferramenta 1: Teste de Bateria e Alternador -->
    <string name="bateria_titulo">Teste de Bateria e Alternador</string>
    <string name="bateria_etapa_n">Etapa %1$d de 3</string>
    <string name="bateria_etapa_concluida">Teste concluído</string>
    <string name="bateria_etapa1_titulo">Bateria em repouso</string>
    <string name="bateria_etapa1_instrucao">Ignição ligada e motor desligado, com faróis, som e ar-condicionado desligados. Toque em Medir: o app lê a tensão por 5 s até ela estabilizar.</string>
    <string name="bateria_etapa2_titulo">Teste de partida (cranking)</string>
    <string name="bateria_etapa2_instrucao">Toque em Iniciar captura e, em seguida, dê a partida normalmente. O app registra o vale mínimo de tensão enquanto o motor de arranque gira. Se o scanner reiniciar por subtensão (LV RESET), o teste continua.</string>
    <string name="bateria_etapa3a_titulo">Alternador em marcha lenta</string>
    <string name="bateria_etapa3a_instrucao">Motor ligado em marcha lenta, sem acelerar. Toque em Medir: 8 s de leitura da tensão de carga.</string>
    <string name="bateria_etapa3b_titulo">Alternador a ~2.500 RPM com cargas</string>
    <string name="bateria_etapa3b_instrucao">Ligue faróis, ventilação no máximo e desembaçador. Mantenha o motor a ~2.500 RPM e toque em Medir: 10 s de leitura.</string>
    <string name="bateria_concluido_instrucao">Desligue as cargas e volte o motor à marcha lenta. Confira o laudo abaixo.</string>
